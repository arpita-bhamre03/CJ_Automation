# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# ---- Active environment ----
ENV=dev

# ---- UI credentials (CentraJob DEV) ----
# Credentials live here ONLY. testdata/users.json holds personas, never passwords.
ADMIN_USERNAME=
ADMIN_PASSWORD=
EMPLOYER_USERNAME=
EMPLOYER_PASSWORD=
COLLEGE_USERNAME=
COLLEGE_PASSWORD=
CANDIDATE_USERNAME=
CANDIDATE_PASSWORD=

# ---- Run configuration ----
REPORTS_DIR=reports
TRACE_MODE=on-first-retry
VIDEO_MODE=retain-on-failure
HEADLESS=true

# ---- API layer (PENDING: values not yet supplied - see README "API automation") ----
# Discovered from the employer frontend (src/api/endpoints.ts): the app calls
# several service base URLs. Fill these in when API automation starts.
ACCOUNT_API_URL=
ADMIN_API_URL=
EMPLOYER_API_URL=
COLLEGE_API_URL=
CANDIDATE_API_URL=
NOTIFICATION_API_URL=

# ---- Cosmos DB (PENDING: values not yet supplied) ----
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=
COSMOS_CONTAINER=
