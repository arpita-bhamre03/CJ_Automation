# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# ---- Active environment ----
ENV=dev

# ---- UI credentials (CentraJob DEV) ----
# IMPORTANT: always wrap values in double quotes. dotenv treats an unquoted '#'
# as the start of a comment, so PASSWORD=Secret#1 is silently read as "Secret",
# which produces a confusing "Invalid Password" failure at the login form.
# Credentials live here ONLY. testdata/users.json holds personas, never passwords.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
EMPLOYER_USERNAME=""
EMPLOYER_PASSWORD=""
COLLEGE_USERNAME=""
COLLEGE_PASSWORD=""
CANDIDATE_USERNAME=""
CANDIDATE_PASSWORD=""

# ---- Run configuration ----
REPORTS_DIR=reports
TRACE_MODE=on-first-retry
VIDEO_MODE=retain-on-failure
HEADLESS=true

# Watch-the-run controls. Keep both at 0 in CI - they only slow things down.
# SLOW_MO    = ms paused before each action, so you can see what is targeted.
# TYPE_DELAY = ms between keystrokes; above 0, text is typed rather than set
#              in one shot, so you can actually see it going in.
# For a demo run try HEADLESS=false, SLOW_MO=500, TYPE_DELAY=80.
SLOW_MO=0
TYPE_DELAY=0

# Admin sign-in MFA. The admin panel asks for an emailed code only when the
# Firebase Remote Config flag enableMFA is true (currently false on DEV).
#   force = switch the flag on in the test browser so the code flow always runs
#   auto  = follow whatever Firebase returns
ADMIN_MFA=force

# ---- API layer (PENDING: values not yet supplied - see README "API automation") ----
# Discovered from the employer frontend (src/api/endpoints.ts): the app calls
# several service base URLs. Fill these in when API automation starts.
ACCOUNT_API_URL=
ADMIN_API_URL=
EMPLOYER_API_URL=
COLLEGE_API_URL=
CANDIDATE_API_URL=
NOTIFICATION_API_URL=

# ---- Cosmos DB (PENDING: values not yet supplied) ----
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=
COSMOS_CONTAINER=
