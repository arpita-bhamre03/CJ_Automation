{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@core/*": ["core/*"],
      "@pages/*": ["pages/*"],
      "@helpers/*": ["helpers/*"],
      "@utilities/*": ["utilities/*"],
      "@api/*": ["api/*"],
      "@testdata/*": ["testdata/*"],
      "@fixtures/*": ["tests/fixtures/*"]
    },
    "types": ["node"]
  },
  "include": [
    "config/**/*.ts",
    "core/**/*.ts",
    "pages/**/*.ts",
    "helpers/**/*.ts",
    "utilities/**/*.ts",
    "api/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "reports", "test-results"]
}
